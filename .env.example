# ===========================================
# Md Abdullah Portfolio - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (Email notifications)
RESEND_API_KEY=
EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Contact form recipient (receives notification emails)
CONTACT_EMAIL=

# Analytics (Vercel Analytics — auto-configured on Vercel deploy, no key needed)
# Custom events work automatically when deployed to Vercel.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=Md Abdullah <hello@yourdomain.com>
CONTACT_EMAIL=your@email.com

